{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ActionIntent",
  "type": "object",
  "required": ["type", "priority"],
  "properties": {
    "type": {
      "type": "string",
      "minLength": 1
    },
    "priority": {
      "type": "integer",
      "minimum": 0
    },
    "target_id": {
      "type": ["string", "null"]
    },
    "position": {
      "type": ["object", "null"],
      "required": ["x", "y"],
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
